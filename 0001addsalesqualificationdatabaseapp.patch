diff --git a/server.js b/server.js
new file mode 100644
index 0000000..044f44c
--- /dev/null
+++ b/server.js
@@ -0,0 +1,151 @@
+const path = require('node:path');
+const fs = require('node:fs');
+const { DatabaseSync } = require('node:sqlite');
+const express = require('express');
+
+const DATA_DIR = path.join(__dirname, 'data');
+const DB_PATH = path.join(DATA_DIR, 'prodajni-algoritem.db');
+fs.mkdirSync(DATA_DIR, { recursive: true });
+
+const db = new DatabaseSync(DB_PATH);
+db.exec(`
+  CREATE TABLE IF NOT EXISTS projects (
+    id TEXT PRIMARY KEY,
+    customer TEXT NOT NULL,
+    project TEXT NOT NULL,
+    seller TEXT DEFAULT '',
+    startdate TEXT DEFAULT '',
+    value TEXT DEFAULT '',
+    createdAt TEXT NOT NULL,
+    updatedAt TEXT NOT NULL,
+    els TEXT NOT NULL DEFAULT '{}'
+  );
+`);
+
+function rowToProject(row) {
+  if (!row) return null;
+  return {
+    id: row.id,
+    customer: row.customer,
+    project: row.project,
+    seller: row.seller || '',
+    startdate: row.startdate || '',
+    value: row.value || '',
+    createdAt: row.createdAt,
+    updatedAt: row.updatedAt,
+    els: JSON.parse(row.els || '{}'),
+  };
+}
+
+const stmts = {
+  listAll: db.prepare('SELECT * FROM projects ORDER BY createdAt DESC'),
+  getOne: db.prepare('SELECT * FROM projects WHERE id = ?'),
+  insert: db.prepare(`
+    INSERT INTO projects (id, customer, project, seller, startdate, value, createdAt, updatedAt, els)
+    VALUES (@id, @customer, @project, @seller, @startdate, @value, @createdAt, @updatedAt, @els)
+  `),
+  replace: db.prepare(`
+    UPDATE projects SET customer=@customer, project=@project, seller=@seller,
+      startdate=@startdate, value=@value, updatedAt=@updatedAt, els=@els
+    WHERE id=@id
+  `),
+  updateEls: db.prepare('UPDATE projects SET els=@els, updatedAt=@updatedAt WHERE id=@id'),
+  remove: db.prepare('DELETE FROM projects WHERE id = ?'),
+};
+
+function genId() {
+  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+}
+
+const app = express();
+app.use(express.json({ limit: '2mb' }));
+app.use(express.static(path.join(__dirname, 'public')));
+
+const api = express.Router();
+
+api.get('/projects', (req, res) => {
+  const rows = stmts.listAll.all();
+  res.json(rows.map(rowToProject));
+});
+
+api.get('/projects/:id', (req, res) => {
+  const row = stmts.getOne.get(req.params.id);
+  if (!row) return res.status(404).json({ error: 'not_found' });
+  res.json(rowToProject(row));
+});
+
+api.post('/projects', (req, res) => {
+  const b = req.body || {};
+  if (!b.customer || !b.customer.trim() || !b.project || !b.project.trim()) {
+    return res.status(400).json({ error: 'customer_and_project_required' });
+  }
+  const now = new Date().toISOString();
+  const project = {
+    id: genId(),
+    customer: b.customer.trim(),
+    project: b.project.trim(),
+    seller: (b.seller || '').trim(),
+    startdate: b.startdate || now.split('T')[0],
+    value: b.value != null ? String(b.value) : '',
+    createdAt: b.createdAt || now,
+    updatedAt: now,
+    els: b.els && typeof b.els === 'object' ? b.els : {},
+  };
+  stmts.insert.run({ ...project, els: JSON.stringify(project.els) });
+  res.status(201).json(project);
+});
+
+api.put('/projects/:id', (req, res) => {
+  const existing = stmts.getOne.get(req.params.id);
+  if (!existing) return res.status(404).json({ error: 'not_found' });
+  const b = req.body || {};
+  const updated = {
+    id: req.params.id,
+    customer: (b.customer ?? existing.customer).trim(),
+    project: (b.project ?? existing.project).trim(),
+    seller: (b.seller ?? existing.seller ?? '').trim(),
+    startdate: b.startdate ?? existing.startdate ?? '',
+    value: b.value != null ? String(b.value) : (existing.value || ''),
+    updatedAt: new Date().toISOString(),
+    els: b.els && typeof b.els === 'object' ? b.els : JSON.parse(existing.els || '{}'),
+  };
+  stmts.replace.run({ ...updated, els: JSON.stringify(updated.els) });
+  res.json(rowToProject(stmts.getOne.get(req.params.id)));
+});
+
+api.patch('/projects/:id/elements/:key', (req, res) => {
+  const existing = stmts.getOne.get(req.params.id);
+  if (!existing) return res.status(404).json({ error: 'not_found' });
+  if (!/^s\d+e\d+$/.test(req.params.key)) {
+    return res.status(400).json({ error: 'invalid_key' });
+  }
+  const els = JSON.parse(existing.els || '{}');
+  const b = req.body || {};
+  els[req.params.key] = {
+    pred: b.pred || '',
+    odg: b.odg || '',
+    vir: b.vir || '',
+    skip: b.skip || '',
+  };
+  const updatedAt = new Date().toISOString();
+  stmts.updateEls.run({ id: req.params.id, els: JSON.stringify(els), updatedAt });
+  res.json({ ok: true, updatedAt });
+});
+
+api.delete('/projects/:id', (req, res) => {
+  const result = stmts.remove.run(req.params.id);
+  if (result.changes === 0) return res.status(404).json({ error: 'not_found' });
+  res.json({ ok: true });
+});
+
+app.use('/api', api);
+
+app.get('/', (req, res) => {
+  res.sendFile(path.join(__dirname, 'public', 'index.html'));
+});
+
+const PORT = process.env.PORT || 3000;
+app.listen(PORT, () => {
+  console.log(`Prodajni algoritem teče na http://localhost:${PORT}`);
+  console.log(`Baza podatkov: ${DB_PATH}`);
+});
